<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="proyectoluisitacomunica.MainPage"
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center">
                <Label Text="Salud" FontSize="28" FontAttributes="Bold" TextColor="White" />
                <Button Text="👤" BackgroundColor="Transparent" TextColor="White" FontSize="20" Clicked="OnPerfilClicked" />
            </FlexLayout>

            <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Actividad de Hoy" TextColor="LightGray" FontSize="14" FontAttributes="Bold" />
                    <micro:ChartView x:Name="chartAnillos" HeightRequest="160" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center">
                    <Label x:Name="lblPasosContador" Text="4250 / 10,000 pasos" TextColor="Orange" FontSize="18" FontAttributes="Bold" />
                    <Button Text="Simular Paso 🚶" BackgroundColor="#FF8C00" TextColor="White" CornerRadius="10" HeightRequest="40" Padding="10,0" Clicked="OnSimularPasoClicked" />
                </FlexLayout>
            </Border>

            <Grid RowSpacing="14" ColumnSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="15" HeightRequest="135">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricaTapped" CommandParameter="Corazón" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Corazón" TextColor="Red" FontSize="15" FontAttributes="Bold" />
                        <Label Text="72 lpm" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Ritmo cardíaco regular" TextColor="DarkGray" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="15" HeightRequest="135">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricaTapped" CommandParameter="Sueño" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sueño" TextColor="MediumPurple" FontSize="15" FontAttributes="Bold" />
                        <Label Text="7h 45m" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Profundo: 2h 10m" TextColor="DarkGray" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="15" HeightRequest="135">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricaTapped" CommandParameter="SpO2" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="SpO2" TextColor="DeepSkyBlue" FontSize="15" FontAttributes="Bold" />
                        <Label Text="98%" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Oxigenación Óptima" TextColor="DarkGray" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="15" HeightRequest="135">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMetricaTapped" CommandParameter="Peso" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Peso" TextColor="LightGreen" FontSize="15" FontAttributes="Bold" />
                        <Label Text="64.5 kg" TextColor="White" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Meta: 62.0 kg" TextColor="DarkGray" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>